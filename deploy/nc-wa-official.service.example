[Unit]
Description=NC-WA SaaS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ncwa
Group=ncwa
WorkingDirectory=/srv/nc-wa-official
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=.env dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# storage/ must exist (owned by ncwa) before the first start. The optional auth/ entry lets an older install
# move its old auth/ directory into storage/ on first start; it can be removed afterwards.
ReadWritePaths=/srv/nc-wa-official/storage /srv/nc-wa-official/data -/srv/nc-wa-official/auth

[Install]
WantedBy=multi-user.target
