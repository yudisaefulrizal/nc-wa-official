DB_HOST=localhost
DB_USER=nc_wa_official
DB_PASSWORD=
DB_NAME=nc_wa_official
HOST=127.0.0.1
PORT=8069
APP_ORIGIN=http://127.0.0.1:8069

# Buat kunci unik melalui npm run setup:secrets. Jangan mengganti setelah data pembayaran tersimpan.
PAYMENT_ENCRYPTION_KEY=
# 0 untuk akses langsung; 1 bila tepat satu reverse proxy tepercaya di depan aplikasi.
TRUST_PROXY_HOPS=0
NODE_ENV=development

# Instagram Login resmi (Meta App Dashboard > Instagram > API setup with Instagram login).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Isi 1 setelah izin instagram_business_manage_insights ditambahkan di Meta App Dashboard (untuk endpoint statistik).
INSTAGRAM_INSIGHTS=
# String acak buatan sendiri; sama dengan kolom "Verifikasi token" di Webhooks Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Fitur WhatsApp disembunyikan dari dashboard; isi 1 untuk menampilkannya lagi.
SHOW_WHATSAPP=
# Fitur Instagram lewat Zernio disembunyikan dari dashboard; isi 1 untuk menampilkannya lagi.
SHOW_ZERNIO=
